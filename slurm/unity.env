# Unity's sbatch flags; the scripts carry only resources. From the repo root:
#     source slurm/unity.env && sbatch $CANNA_SBATCH_GPU slurm/lisa.sbatch narrow-B
# A GPU type or a short QOS goes after it on the command line, e.g. --gres=gpu:1080_ti:1 --qos=short
export CANNA_SBATCH_GPU="--partition=gpu --account=pi_mehuber_umass_edu --qos=normal"
export CANNA_SBATCH_CPU="--partition=cpu --account=pi_mehuber_umass_edu --qos=normal"
mkdir -p .slurm-logs
