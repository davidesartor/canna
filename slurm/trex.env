# TREX's sbatch flags; the scripts carry only resources. From the repo root:
#     source slurm/trex.env && sbatch $CANNA_SBATCH_GPU slurm/lisa.sbatch narrow-B
# The default QOS (cpu_2022_1280) is rejected by the GPU partitions, which take only normal or
# gpu_all; check `sacctmgr show assoc user=$USER format=qos` if gpu_all is refused too. On the CPU
# partition the default QOS is its own, so CPU jobs pass none.
# gpu_a100 / gpu_h100 cap at 1 day; gpu_std at 3; gpu_aivip_max at 10 on the same A100 nodes.
# Resuming works, so a 1-day chunk plus re-submission is equivalent to a long allocation --
# switch to gpu_aivip_max only if you are entitled to it.
export CANNA_SBATCH_GPU="--partition=gpu_a100 --account=lisa --qos=gpu_all"
export CANNA_SBATCH_CPU="--partition=cpu2022 --account=lisa"
mkdir -p .slurm-logs
